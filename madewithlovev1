<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Retro Apple MP3 Player</title>
    <style>
        :root {
            --ipod-bg: #e0e0e0;
            --screen-bg: #1a1a1a;
            --apple-blue: #007aff;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f5f5f7;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        /* Body iPod */
        .ipod {
            width: 300px;
            height: 520px;
            background: var(--ipod-bg);
            border-radius: 40px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.2), inset 0 -5px 10px rgba(0,0,0,0.1);
            padding: 25px;
            display: flex;
            flex-direction: column;
            align-items: center;
            border: 1px solid #ccc;
        }

        /* Layar */
        .screen {
            width: 100%;
            height: 230px;
            background: var(--screen-bg);
            border-radius: 10px;
            margin-bottom: 25px;
            overflow: hidden;
            color: white;
            display: flex;
            flex-direction: column;
            border: 4px solid #333;
        }

        .screen-header {
            padding: 8px;
            font-size: 11px;
            text-align: center;
            border-bottom: 1px solid #333;
            background: #222;
            letter-spacing: 1px;
        }

        .now-playing {
            flex: 1;
            padding: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        /* Gambar Album (Menggunakan icemode.jpg) */
        #album-art {
            width: 110px;
            height: 110px;
            background-color: #333;
            border-radius: 4px;
            margin-bottom: 12px;
            object-fit: cover;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            background-image: url('icemode.jpg');
            background-size: cover;
        }

        #song-title { font-weight: bold; font-size: 14px; margin-bottom: 3px; color: var(--apple-blue); }
        #artist-name { font-size: 12px; opacity: 0.7; }

        /* Click Wheel */
        .wheel {
            width: 180px;
            height: 180px;
            background: white;
            border-radius: 50%;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            cursor: pointer;
        }

        .center-button {
            width: 65px;
            height: 65px;
            background: #eee;
            border-radius: 50%;
            border: 1px solid #ddd;
            z-index: 10;
            transition: transform 0.1s;
        }

        .center-button:active { transform: scale(0.92); }

        .wheel-label {
            position: absolute;
            font-weight: bold;
            color: #777;
            font-size: 11px;
            user-select: none;
        }

        .menu { top: 15px; }
        .next { right: 15px; }
        .prev { left: 15px; }
        .play-pause { bottom: 15px; }

        #audio-player { display: none; }
    </style>
</head>
<body>

<div class="ipod">
    <div class="screen">
        <div class="screen-header">iPod Classic</div>
        <div class="now-playing">
            <div id="album-art"></div>
            <!-- Ganti teks di bawah ini sesuai lagu Anda -->
            <div id="song-title">@JERUKLIAR</div>
            <div id="artist-name">Made With ❤️ </div>
        </div>
    </div>

    <!-- Seluruh roda (wheel) bisa diklik untuk play/pause -->
    <div class="wheel" onclick="togglePlay()">
        <div class="wheel-label menu">MENU</div>
        <div class="wheel-label next">▶▶</div>
        <div class="wheel-label prev">◀◀</div>
        <div class="wheel-label play-pause">▶/Ⅱ</div>
        <div class="center-button"></div>
    </div>
</div>

<!-- Ganti src="lovesong❤️.mp3" dengan nama file lagu Anda di GitHub -->
<audio id="audio-player" src="lovesong❤️.mp3"></audio>

<script>
    const audio = document.getElementById('audio-player');
    const songTitle = document.getElementById('song-title');

    function togglePlay() {
        if (audio.paused) {
            audio.play();
            songTitle.style.color = "#007aff"; // Warna biru saat main
        } else {
            audio.pause();
            songTitle.style.color = "white"; // Warna putih saat pause
        }
    }
</script>

</body>
</html>
